+// One owned process consumes serial bounded requests. The original per-request
+// read/write denial and source validation remain inside execute(), unchanged.
+class CappedErrorBuffer final : public std::streambuf {
+public:
+  std::string text;
+protected:
+  std::streamsize xsputn(const char* data,std::streamsize size) override {
+    if (size>0) text.append(data,std::min<std::size_t>(std::size_t(size),8192-text.size()));
+    return size;
+  }
+  int_type overflow(int_type value) override {
+    if (!traits_type::eq_int_type(value,traits_type::eof()) && text.size()<8192)
+      text.push_back(traits_type::to_char_type(value));
+    return traits_type::not_eof(value);
+  }
+};
+void controlFrame(const char* magic,const Json& value) {
+  const auto text=value.dump();require(text.size()<=1048576,"worker control header exceeds bound");
+  const std::uint64_t size=text.size(),zero=0;
+  std::cout.write(magic,8);std::cout.write(reinterpret_cast<const char*>(&size),8);
+  std::cout.write(reinterpret_cast<const char*>(&zero),8);std::cout.write(text.data(),text.size());
+  std::cout.flush();require(bool(std::cout),"worker output pipe failed");
+}
+int worker(const std::vector<fs::path>& fixed) {
+  try {
+    require(fixed.size()==4,"invalid worker launch");ordinary(fixed[1],true);ordinary(fixed[3],true);
+#ifdef _WIN32
+    require(_setmode(_fileno(stdout),_O_BINARY)!=-1 && _setmode(_fileno(stdin),_O_BINARY)!=-1,
+            "worker binary pipe unavailable");
+#endif
+    controlFrame("ZMDWRK01",Json{{"schema","zhumadian.osgb.worker.v1"},{"readOnly",true},
+                 {"maxHeaderBytes",1048576},{"maxPayloadBytes",maxPayload},{"requestLimitBytes",4096}});
+    for (;;) {
+      std::string line;char c=0;
+      while (std::cin.get(c) && c!='\n') {
+        require(line.size()<4096,"worker request exceeds bound");line.push_back(c);
+      }
+      if (line.empty() && !std::cin) return 0;
+      require(bool(std::cin),"worker request is incomplete");
+      const auto request=Json::parse(line);
+      require(request.is_object() && request.size()==2 && request.contains("node") && request.contains("mode") &&
+              request.at("node").is_string() && (request.at("mode").is_null() || request.at("mode").is_string()),
+              "invalid worker request shape");
+      const auto node=request.at("node").get<std::string>();
+      require(node.size()<=256 && std::all_of(node.begin(),node.end(),[](unsigned char n){return n>=32 && n<127;}),
+              "invalid worker node text");
+      std::vector<fs::path> args={fixed[0],fixed[1],fs::u8path(node),fixed[3]};
+      if (!request.at("mode").is_null()) {
+        const auto mode=request.at("mode").get<std::string>();require(mode.size()<=128,"worker mode exceeds bound");
+        args.push_back(fs::u8path(mode));
+      }
+      CappedErrorBuffer errors;auto* previous=std::cerr.rdbuf(&errors);
+      const int status=execute(args);std::cerr.rdbuf(previous);
+      if (status) {
+        while (!errors.text.empty() && (errors.text.back()=='\n' || errors.text.back()=='\r')) errors.text.pop_back();
+        const bool imageBudget=request.at("mode").is_null() && errors.text=="embedded image exceeds byte budget";
+        controlFrame("ZMDERR01",Json{{"schema","zhumadian.osgb.worker_error.v1"},{"node",node},
+                     {"mode",request.at("mode")},{"returnCode",status},
+                     {"reason",imageBudget?"full_image_budget":"decode_refused"},{"message",errors.text}});
+      }
+    }
+  } catch (const std::exception& error) {
+    std::cerr<<error.what()<<'\n';return 1;
+  }
+}

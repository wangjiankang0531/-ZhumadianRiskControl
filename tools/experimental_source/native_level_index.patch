+    nlohmann::json master,catalog;std::string catalogSHA;std::ifstream masterInput(resolveProjectPath("data/showcase/zhumadian_native_hierarchy.json"));masterInput>>master;
+    for (const auto& root:master.at("root_records")) if (root.at("tile_id")==tile) {
+      const std::string expected="assets/showcase/runtime/zhumadian/native_hierarchy/tile_"+std::to_string(tile)+".json";
+      if (root.at("catalog")!=expected) throw std::runtime_error("Original topology path differs");
+      std::ifstream input(resolveProjectPath(expected),std::ios::binary);std::vector<uint8_t> raw((std::istreambuf_iterator<char>(input)),{});
+      catalogSHA=sourceMemorySHA(raw.data(),raw.size());
+      if (catalogSHA!=root.at("sha256").get<std::string>()) throw std::runtime_error("Original topology SHA changed");catalog=nlohmann::json::parse(raw);break;
+    }
+    result.sourceRoot=catalog.at("root");for (const auto& record:catalog.at("nodes"))
+      result.topology.push_back({record.at("name"),record.at("children").get<std::vector<std::string>>()});
+    std::map<std::string,nlohmann::json> indexedSources;
+    std::ifstream boundsInput(resolveProjectPath("data/showcase/level_index/tile_"+std::to_string(tile)+".json"));
+    if (boundsInput) {
+      nlohmann::json exact;boundsInput>>exact;
+      if (exact.at("schema")!="zhumadian.level_bounds.tile.v1" || exact.at("complete")!=true ||
+          exact.at("tile")!=tile || exact.at("catalogSHA256")!=catalogSHA)
+        throw std::runtime_error("Exact source subtree index identity differs");
+      for (const auto& row:exact.at("nodes")) if (result.sources.contains(row.at("name").get<std::string>()))
+        if (!indexedSources.emplace(row.at("name").get<std::string>(),row).second)
+          throw std::runtime_error("Duplicate exact source subtree bounds");
+      if (indexedSources.size()!=result.sources.size()) throw std::runtime_error("Missing exact source subtree bounds");
+    }
+    hongtu::renderer::NativeSourceFrontier::Cut cut;for (auto& [name,node]:result.sources) {
+      auto found=std::find_if(catalog.at("nodes").begin(),catalog.at("nodes").end(),[&](const auto& n){return n.at("name")==name;});
+      if (found==catalog.at("nodes").end() || found->at("children")!=node.children) throw std::runtime_error("Original topology differs from source");
+      if (!indexedSources.empty()) {
+        const auto& row=indexedSources.at(name);
+        if (row.at("sourceSHA256")!=found->at("sha256") || row.at("children")!=node.children)
+          throw std::runtime_error("Indexed source subtree belongs to another original node");
+        for (int axis=0;axis<3;++axis) {
+          node.subtreeLow[axis]=row.at("subtreeMin").at(axis);node.subtreeHigh[axis]=row.at("subtreeMax").at(axis);
+          if (!std::isfinite(node.subtreeLow[axis]+node.subtreeHigh[axis]) ||
+              node.subtreeLow[axis]>node.low[axis]+.01f || node.subtreeHigh[axis]<node.high[axis]-.01f)
+            throw std::runtime_error("Indexed subtree omits original rendered geometry");
+          node.expansion=std::max({node.expansion,node.low[axis]-node.subtreeLow[axis],node.subtreeHigh[axis]-node.high[axis]});
+        }
+        node.hasSubtreeBounds=true;
+      }
+      cut.insert(name);
+    }
+    hongtu::renderer::NativeSourceFrontier checked(result.topology,family?parent:result.sourceRoot,cut,result.payload,384ull*1048576);
+    result.valid=result.frontier>0 && std::isfinite(result.edge) && result.edge>0 && std::isfinite(result.texel) && result.texel>0;
+    std::cerr<<"[readonly_source_memory] tile="<<tile<<" depth="<<depth<<" pages="<<result.parts.size()<<" bytes="<<result.payload<<" parent="<<parent<<'\n';
+  } catch (const std::exception& error) {result={};result.error=error.what();}
+  return result;
+}
+
+// Actual allocation is checked immediately; changing a ledger alone cannot pass.
+uint64_t sourceMemorySingleMipUploads=0,sourceMemoryCheckedMipUploads=0;
+bool sourceMemoryUpload(RHIDevice* device,const ZhumadianNativeCpu& cpu,RHITexturePtr& texture,RHITextureViewPtr& view) {
+  if (!createUploadedRgbaTexture(device,cpu.image.width,cpu.image.height,cpu.image.rgba,texture,view,cpu.sourceMipLevels!=1)) return false;
+  uint32_t expected=cpu.sourceMipLevels;
+  if (!expected) {expected=1;uint32_t side=std::max(cpu.image.width,cpu.image.height);while(side>1){side/=2;++expected;}}
+  if (texture->getMipLevels()!=expected) throw std::runtime_error("Actual original-source GPU mip allocation differs");
+  ++sourceMemoryCheckedMipUploads;if (expected==1) ++sourceMemorySingleMipUploads;return true;
+}

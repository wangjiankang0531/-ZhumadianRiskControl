+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+// Pure raster coverage comparison used by the precommit GPU geometry check.
+// Keep the old complete source on interior loss; two pixels tolerate raster edges.
+struct ZhumadianNativeCoverageMask {
+static uint64_t coverageInteriorLoss(const std::vector<uint8_t>& parent,
+                                    const std::vector<uint8_t>& child,uint32_t width,uint32_t height) {
+  if (!width || !height || parent.size()!=size_t(width)*height*4 || child.size()!=parent.size())
+    throw std::runtime_error("Invalid geometric coverage masks");
+  const size_t stride=size_t(width)+1;
+  std::vector<uint32_t> p(stride*(height+1)),c(p.size());
+  for (uint32_t y=0;y<height;++y) for (uint32_t x=0;x<width;++x) {
+    const size_t at=size_t(y+1)*stride+x+1,pixel=(size_t(y)*width+x)*4;
+    p[at]=(parent[pixel]!=0)+p[at-1]+p[at-stride]-p[at-stride-1];
+    c[at]=(child[pixel]!=0)+c[at-1]+c[at-stride]-c[at-stride-1];
+  }
+  const auto sum=[&](const auto& a,int x0,int y0,int x1,int y1) {
+    return a[size_t(y1)*stride+x1]-a[size_t(y0)*stride+x1]-a[size_t(y1)*stride+x0]+a[size_t(y0)*stride+x0];
+  };
+  uint64_t loss=0;
+  // Two raster pixels tolerate boundary/subpixel displacement. Interior holes
+  // are forbidden; the test includes screen edges, with clipped neighborhoods.
+  for (int y=0;y<int(height);++y) for (int x=0;x<int(width);++x) {
+    const int x0=std::max(0,x-2),y0=std::max(0,y-2),x1=std::min(int(width),x+3),y1=std::min(int(height),y+3);
+    loss += sum(p,x0,y0,x1,y1)==uint32_t((x1-x0)*(y1-y0)) && sum(c,x0,y0,x1,y1)==0;
+  }
+  return loss;
+}
+};

--- /dev/null
+++ b/Application/native/native_family_cost_priority.inl
@@ -0,0 +1,40 @@
+// Optional prepared-cache family quality gain per MiB. Admission still uses actual bytes.
+struct FamilyAdmissionHint { uint64_t bytes; float edge,texel; bool available; };
+std::map<std::pair<int,std::string>,FamilyAdmissionHint> familyAdmissionHints;
+#include "native_family_spatial_priority.inl"
+bool familyCostPriorityEnabled() const {
+ const char* flag=std::getenv("HT_NATIVE_FAMILY_COST_PRIORITY");
+ return visibleInitialCoverageEnabled() && flag && std::string(flag)=="1";
+}
+void installFamilyAdmissionHints(const nlohmann::json& rows) {
+ if(!rows.is_array() || rows.size()>256) throw std::runtime_error("Family index row limit");
+ decltype(familyAdmissionHints) next;auto costs=visibilityFamilyCosts;
+ for(const auto& row:rows) {
+  const int tile=row.at("tile");const std::string parent=row.at("parent");
+  const uint64_t bytes=row.at("payloadBytes");const float edge=row.at("edge"),texel=row.at("texel");
+  if(tile<1 || tile>10000 || !std::regex_match(parent,std::regex("Tile_"+std::to_string(tile)+"_L[0-9]+_0[0-9u]+\\.osgb")) ||
+     !bytes || bytes>384ull*1048576 || !std::isfinite(edge) || !(edge>0) || !std::isfinite(texel) || texel<0)
+   throw std::runtime_error("Invalid family index metric or identity");
+  const auto key=std::make_pair(tile-1,parent);if(!next.emplace(key,FamilyAdmissionHint{bytes,edge,texel,row.at("available").get<bool>()}).second)
+   throw std::runtime_error("Duplicate family index identity");
+  if(costs.contains(key) && costs.at(key)!=bytes) throw std::runtime_error("Previously learned family cost differs");
+  costs[key]=bytes;
+ }
+ auto spatial=parseFamilySpatialHints(rows);
+ familyAdmissionHints.swap(next);visibilityFamilyCosts.swap(costs);familySpatialHints.swap(spatial);familyAdmissionMisses.clear();familyAdmissionMissSkips=0;
+}
+double indexedFamilyRankScore(int id,const std::string& parent,float edge,float texel,float fov,int height) const {
+ const double current=visibilityPriority(id,parent,{edge,texel},fov,height);
+ if(!familyCostPriorityEnabled()) return current;
+ if(familyMissCacheEnabled() && familyAdmissionMisses.contains({id,parent})){++familyAdmissionMissSkips;return 0;}
+ const auto found=familyAdmissionHints.find({id,parent});
+ if(found==familyAdmissionHints.end()) return current; // Unknown bundles keep the prior discovery path.
+ const auto& hint=found->second;if(!hint.available) return 0;
+ const double estimated=familySpatialPriorityEnabled()?familySpatialEstimatedPriority(id,parent,edge,texel,fov,height):visibilityPriority(id,parent,{hint.edge,hint.texel},fov,height);
+ return std::max(0.0,current-estimated)/(double(hint.bytes)/1048576.0);
+}
+bool familyAdmissionMatches(int id,const std::string& parent,uint64_t bytes,float edge,float texel) const {
+ if(!familyCostPriorityEnabled()) return true;
+ const auto found=familyAdmissionHints.find({id,parent});if(found==familyAdmissionHints.end())return true;
+ const auto& hint=found->second;return hint.available && hint.bytes==bytes && hint.edge==edge && hint.texel==texel;
+}
diff --git a/Application/native/native_family_spatial_priority.inl b/Application/native/native_family_spatial_priority.inl
new file mode 100644
index 0000000..beaebb9
--- /dev/null
+++ b/Application/native/native_family_spatial_priority.inl
@@ -0,0 +1,59 @@
+// Prepared-index epoch miss cache and per-visible-pixel conservative child-box forecast.
+struct FamilySpatialChild {std::array<double,3> low,high;float error;};
+struct FamilyVisiblePixel {std::array<double,3> origin,direction;double nearDepth,farDepth,weight;uint8_t depthBin;};
+using FamilyKey=std::pair<int,std::string>;
+std::map<FamilyKey,std::vector<FamilySpatialChild>> familySpatialHints;
+std::map<FamilyKey,std::vector<FamilyVisiblePixel>> familyVisiblePixels;
+std::set<FamilyKey> familyAdmissionMisses;
+mutable uint64_t familyAdmissionMissSkips=0;
+bool familyMissCacheEnabled() const {
+ const char* flag=std::getenv("HT_NATIVE_FAMILY_MISS_CACHE");return familyCostPriorityEnabled() && flag && std::string(flag)=="1";
+}
+bool familySpatialPriorityEnabled() const {
+ const char* flag=std::getenv("HT_NATIVE_FAMILY_SPATIAL_PRIORITY");return familyCostPriorityEnabled() && flag && std::string(flag)=="1";
+}
+static auto parseFamilySpatialHints(const nlohmann::json& rows) {
+ std::map<FamilyKey,std::vector<FamilySpatialChild>> result;
+ for(const auto& row:rows) {
+  if(!row.contains("children"))continue;const auto& children=row.at("children");
+  if(!children.is_array() || children.empty() || children.size()>64)throw std::runtime_error("Invalid family spatial child count");
+  std::vector<FamilySpatialChild> values;std::set<std::string> names;const int tile=row.at("tile");
+  for(const auto& child:children) {
+   const std::string name=child.at("name");
+   if(!std::regex_match(name,std::regex("Tile_"+std::to_string(tile)+"_L[0-9]+_0[0-9u]+\\.osgb")) || !names.insert(name).second)throw std::runtime_error("Invalid spatial child identity");
+   if(!child.at("bounds_min").is_array() || child.at("bounds_min").size()!=3 || !child.at("bounds_max").is_array() || child.at("bounds_max").size()!=3)throw std::runtime_error("Invalid child box size");
+   const auto low=child.at("bounds_min").get<std::array<double,3>>(),high=child.at("bounds_max").get<std::array<double,3>>();
+   const float edge=child.at("longest_edge_p90_m"),texel=child.at("texel_world_p90_m");
+   for(size_t axis=0;axis<3;++axis)if(!std::isfinite(low[axis]) || !std::isfinite(high[axis]) || low[axis]>high[axis])throw std::runtime_error("Invalid child box bounds");
+   if(!std::isfinite(edge) || edge<=0 || !std::isfinite(texel) || texel<0)throw std::runtime_error("Invalid child quality");
+   values.push_back({low,high,std::max(edge,texel*4)});
+  }
+  result.emplace(FamilyKey{tile-1,row.at("parent").get<std::string>()},std::move(values));
+ }
+ return result;
+}
+void noteFamilyAdmissionFailure(int id,const std::string& parent,const std::string& reason) {
+ if(familyMissCacheEnabled() && (reason=="Cannot open derived cache reader lock" || reason=="Prepared resource missing or traverses a reparse point"))familyAdmissionMisses.insert({id,parent});
+}
+static bool familyPixelIntersects(const FamilyVisiblePixel& pixel,const FamilySpatialChild& child,double padding) {
+ double nearDistance=0,farDistance=std::numeric_limits<double>::infinity();
+ for(size_t axis=0;axis<3;++axis) {
+  const double low=child.low[axis]-padding,high=child.high[axis]+padding,origin=pixel.origin[axis],direction=pixel.direction[axis];
+  if(std::abs(direction)<1e-12){if(origin<low || origin>high)return false;continue;}
+  const double a=(low-origin)/direction,b=(high-origin)/direction;nearDistance=std::max(nearDistance,std::min(a,b));farDistance=std::min(farDistance,std::max(a,b));if(nearDistance>farDistance)return false;
+ }
+ return farDistance>=pixel.nearDepth && nearDistance<=pixel.farDepth;
+}
+double familySpatialEstimatedPriority(int id,const std::string& parent,float edge,float texel,float fov,int height) const {
+ const FamilyKey key{id,parent};const auto hint=familySpatialHints.find(key),unused=familySpatialHints.end();
+ const auto pixels=familyVisiblePixels.find(key);const auto& base=familyAdmissionHints.at(key);
+ if(hint==unused || pixels==familyVisiblePixels.end() || pixels->second.empty())return visibilityPriority(id,parent,{base.edge,base.texel},fov,height);
+ const float parentError=std::max(edge,texel*4);std::map<float,std::array<double,256>> groups;
+ for(const auto& pixel:pixels->second) {
+  float error=0;for(const auto& child:hint->second)if(familyPixelIntersects(pixel,child,parentError))error=std::max(error,child.error);
+  if(!(error>0))error=parentError;groups[error][pixel.depthBin]+=pixel.weight;
+ }
+ double predicted=0;for(const auto& [error,bins]:groups)predicted+=visibilityPriority({error,0},bins,fov,height);return predicted;
+}
+
+size_t familyVisiblePixelCount()const{size_t count=0;for(const auto& [key,pixels]:familyVisiblePixels)count+=pixels.size();return count;}

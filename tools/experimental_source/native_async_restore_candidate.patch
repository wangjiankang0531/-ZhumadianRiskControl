diff --git a/Application/native/landscape_prepared_cache.hpp b/Application/native/landscape_prepared_cache.hpp
new file mode 100644
index 0000000..1458615
--- /dev/null
+++ b/Application/native/landscape_prepared_cache.hpp
@@ -0,0 +1,263 @@
+#pragma once
+#ifdef _WIN32
+// CNG declarations require Win32 types before bcrypt.h.
+// clang-format off
+#  include <windows.h>
+#  include <bcrypt.h>
+// clang-format on
+#  pragma comment(lib, "bcrypt.lib")
+#endif
+#include <nlohmann/json.hpp>
+
+#include <array>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <map>
+#include <regex>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace hongtu::landscape::prepared {
+  using Json = nlohmann::json;
+  namespace fs = std::filesystem;
+  inline void require(bool value, const char* message) {
+    if (!value)
+      throw std::runtime_error(message);
+  }
+  inline fs::path rootFromEnvironment() {
+#ifdef _WIN32
+    const DWORD length = GetEnvironmentVariableW(L"HT_LANDSCAPE_PREPARED_ROOT", nullptr, 0);
+    if (!length)
+      return {};
+    require(length < 32768, "Prepared resource root exceeds limit");
+    std::wstring text(length, L'\0');
+    const DWORD read = GetEnvironmentVariableW(L"HT_LANDSCAPE_PREPARED_ROOT", text.data(), length);
+    require(read > 0 && read < length, "Prepared resource root changed");
+    text.resize(read);
+    fs::path root(text);
+    require(root.is_absolute() && fs::is_directory(root),
+            "Prepared resource root must be an existing absolute directory");
+    return root.lexically_normal();
+#else
+    return {};
+#endif
+  }
+  inline fs::path owned(const fs::path& root, const fs::path& relative) {
+    require(root.is_absolute() && !relative.is_absolute() && !relative.has_root_name(),
+            "Prepared path must be relative to its owner");
+    auto path = root;
+    auto check = [](const fs::path& p) {
+#ifdef _WIN32
+      DWORD attributes = GetFileAttributesW(p.c_str());
+      require(attributes != INVALID_FILE_ATTRIBUTES && !(attributes & FILE_ATTRIBUTE_REPARSE_POINT),
+              "Prepared resource missing or traverses a reparse point");
+#else
+      require(fs::exists(p) && !fs::is_symlink(p), "Prepared resource missing or traverses a link");
+#endif
+    };
+    check(path);
+    for (const auto& component : relative) {
+      require(component != ".." && component.native().find(fs::path(":").native()) == fs::path::string_type::npos,
+              "Prepared path escapes its owner");
+      if (component == "." || component.empty())
+        continue;
+      path /= component;
+      check(path);
+    }
+    return path;
+  }
+  inline std::string digest(const unsigned char* data, size_t size) {
+#ifdef _WIN32
+    BCRYPT_ALG_HANDLE algorithm = nullptr;
+    BCRYPT_HASH_HANDLE hash = nullptr;
+    require(BCryptOpenAlgorithmProvider(&algorithm, BCRYPT_SHA256_ALGORITHM, nullptr, 0) >= 0,
+            "SHA256 provider unavailable");
+    std::array<unsigned char, 32> output{};
+    try {
+      require(BCryptCreateHash(algorithm, &hash, nullptr, 0, nullptr, 0, 0) >= 0, "SHA256 state unavailable");
+      require(size <= std::numeric_limits<ULONG>::max() &&
+                  BCryptHashData(hash, const_cast<PUCHAR>(data), static_cast<ULONG>(size), 0) >= 0,
+              "SHA256 input rejected");
+      require(BCryptFinishHash(hash, output.data(), static_cast<ULONG>(output.size()), 0) >= 0, "SHA256 finish failed");
+    } catch (...) {
+      if (hash)
+        BCryptDestroyHash(hash);
+      BCryptCloseAlgorithmProvider(algorithm, 0);
+      throw;
+    }
+    BCryptDestroyHash(hash);
+    BCryptCloseAlgorithmProvider(algorithm, 0);
+    std::string result;
+    result.reserve(64);
+    const char* hex = "0123456789abcdef";
+    for (auto byte : output) {
+      result += hex[byte >> 4];
+      result += hex[byte & 15];
+    }
+    return result;
+#else
+    throw std::runtime_error("Prepared cache hashing requires Windows CNG");
+#endif
+  }
+  inline std::string digest(const std::string& data) {
+    return digest(reinterpret_cast<const unsigned char*>(data.data()), data.size());
+  }
+  inline std::string read(const fs::path& path, uintmax_t maximum) {
+    const auto size = fs::file_size(path);
+    const auto time = fs::last_write_time(path);
+    require(size > 0 && size <= maximum, "Prepared resource exceeds file limit");
+    std::ifstream input(path, std::ios::binary);
+    require(bool(input), "Prepared resource cannot be opened");
+    std::string bytes(static_cast<size_t>(size), '\0');
+    input.read(bytes.data(), static_cast<std::streamsize>(size));
+    require(input.gcount() == static_cast<std::streamsize>(size) && input.peek() == std::char_traits<char>::eof() &&
+                fs::file_size(path) == size && fs::last_write_time(path) == time,
+            "Prepared resource changed during read");
+    return bytes;
+  }
+  inline std::string bundleName(int tile, int depth, const std::string& parent) {
+    require(tile >= 1 && tile <= 2346, "Prepared tile request outside bounds");
+    if (parent.empty())
+      require(depth >= 1 && depth <= 12, "Prepared frontier depth outside bounds");
+    if (parent.empty())
+      return "tile_" + std::to_string(tile) + "_depth_" + std::to_string(depth);
+    require(std::regex_match(parent, std::regex("Tile_" + std::to_string(tile) + "_L[0-9]+_0[0-9u]+\\.osgb")),
+            "Prepared family parent differs from tile");
+    return "family_tile_" + std::to_string(tile) + "_" + digest(parent).substr(0, 16);
+  }
+  inline fs::path resolve(const fs::path& root, const fs::path& input) {
+    auto relative = input.is_absolute() ? input.lexically_relative(root) : input;
+    require(!input.is_absolute() || input == root || !relative.empty(), "Prepared absolute resource path outside root");
+    require(root.is_absolute() && !relative.is_absolute() && !relative.has_root_name(),
+            "Prepared resource path outside root");
+    auto result = root;
+    for (const auto& part : relative) {
+      require(part != ".." && part.native().find(fs::path(":").native()) == fs::path::string_type::npos,
+              "Prepared resource path escapes root");
+      if (part == "." || part.empty())
+        continue;
+      result /= part;
+#ifdef _WIN32
+      DWORD attributes = GetFileAttributesW(result.c_str());
+      require(attributes == INVALID_FILE_ATTRIBUTES || !(attributes & FILE_ATTRIBUTE_REPARSE_POINT),
+              "Prepared resource traverses a reparse point");
+#endif
+    }
+    return result;
+  }
+  inline Json loadMarker(const fs::path& root, const fs::path& folder) {
+    const auto relative = folder.lexically_relative(root);
+    return Json::parse(read(owned(root, relative / "complete.json"), 16 * 1048576));
+  }
+  inline void checkUris(const Json& node) {
+    if (node.is_object()) {
+      for (const auto& [key, value] : node.items()) {
+        if (key == "uri")
+          require(value.is_string() && (value == "geometry.bin" || value == "atlas.jpg"),
+                  "Prepared glTF URI escapes declared physical files");
+        checkUris(value);
+      }
+    } else if (node.is_array())
+      for (const auto& value : node)
+        checkUris(value);
+  }
+  inline void validateBundle(const fs::path& root,
+                             const fs::path& folder,
+                             const Json& marker,
+                             int tile,
+                             int depth,
+                             const std::string& parent,
+                             const fs::path& producerRoot = {},
+                             const fs::path& cacheRoot = {},
+                             bool historicalOriginalPixels = false) {
+    const bool family = !parent.empty();
+    const auto name = bundleName(tile, depth, parent);
+    const auto cache = cacheRoot.empty() ? root / "work/zhumadian_native_chunk_cache" : cacheRoot;
+    owned(root, cache.lexically_relative(root));
+    require(folder == cache / name, "Prepared bundle directory mismatch");
+    require(marker.at("tile_id") == tile && marker.at("texture_policy") == "original_pixels_v1",
+            "Prepared source identity differs");
+    if (family) {
+      require(marker.at("schema") == "xnby.osgb_native_family.v1" && marker.at("complete_sibling_family") == true &&
+                  marker.at("replacement_parent") == parent && marker.at("family_key") == name.substr(name.size() - 16),
+              "Prepared family is incomplete");
+    } else {
+      require(marker.at("schema") == "hongtu.osgb_native_chunk_bundle.v1" && marker.at("complete_frontier") == true &&
+                  marker.at("depth") == depth,
+              "Prepared frontier is incomplete");
+    }
+    const std::map<std::string, std::string> producers = {
+        {"converter_sha256", "convert_zhumadian_native_chunks.py"},
+        {"family_converter_sha256", "convert_zhumadian_native_family.py"},
+        {"texture_helper_sha256", "native_texture_parts.py"},
+        {"frontier_helper_sha256", "native_source_frontier.py"},
+        {"atlas_recipe_sha256", "native_atlas_recipe.py"},
+        {"native_helper_sha256", "convert_zhumadian_native_root.py"},
+        {"packer_sha256", "build_zhumadian_full_stage.py"},
+        {"tight_layout_sha256", "native_tight_atlas.py"},
+        {"edge_layout_sha256", "native_edge_clamp_atlas.py"},
+        {"rectangular_layout_sha256", "native_rectangular_atlas.py"},
+        {"packed_layout_sha256", "native_packed_rect_atlas.py"}};
+    const auto& stamp = marker.at("stamp");
+    if (historicalOriginalPixels) {
+      // Exact pre-atlas-recipe producer version. Never infer compatibility from
+      // the reused v1 schema or missing fields alone.
+      const std::map<std::string, std::string> legacy = {
+          {"converter_sha256", "e17a2adea9315b3850b218f29ce75dcad61b187e9e08736dac861efa04f663bb"},
+          {"family_converter_sha256", "39834d4d65b6aaa65fa21ddd5e937c727111d57ef4e13f221925503bef319606"},
+          {"texture_helper_sha256", "1b848a25fbf99d77b006868e173e3200a97a5b7e33424e1a05cabdadd488a667"},
+          {"frontier_helper_sha256", "c0942d60eb7b6c8d7047c0dafba0535ddaae67f5d10c262e820fa97237d2a15a"},
+          {"native_helper_sha256", "13f805999c8e4005a1c470e6aaa2d4831cfd47b24787b08683b8fde1ccba158f"},
+          {"packer_sha256", "9feeef9dfd645b28998fd5f514cbd12c4cdb12e5045e22e746c9463878e888f1"}};
+      require(!stamp.contains("atlas_recipe_sha256") && stamp.at("exporter_sha256") ==
+                                                            "e67ec3ffc4cd806e25a68e723311ae575007b856e33d96aa93d81d3fe3"
+                                                            "a2d1ba",
+              "Historical producer recipe differs");
+      for (const auto& [key, expected] : legacy)
+        if (family || key != "family_converter_sha256")
+          require(stamp.at(key) == expected, "Unsupported historical producer version");
+    } else {
+      for (const auto* key :
+           {"converter_sha256", "texture_helper_sha256", "frontier_helper_sha256", "atlas_recipe_sha256"})
+        require(stamp.contains(key), "Prepared producer identity missing");
+    }
+    require(!family || stamp.contains("family_converter_sha256"), "Prepared family producer identity missing");
+    for (const auto& [key, file] : producers)
+      if (stamp.contains(key))
+        require(
+            stamp.at(key) ==
+                digest(read(owned(producerRoot.empty() ? root : producerRoot, fs::path("tools") / file), 4 * 1048576)),
+            "Prepared producer identity changed");
+    const auto& parts = marker.at("parts");
+    require(parts.is_array() && !parts.empty() && parts.size() <= 64, "Prepared physical page set incomplete");
+    uint64_t payload = 0;
+    for (size_t i = 0; i < parts.size(); ++i) {
+      const auto& part = parts[i];
+      auto expected = "part_" + std::string(3 - std::to_string(i).size(), '0') + std::to_string(i);
+      require(part.at("directory") == expected && part.at("gpu_payload_bytes").is_number_unsigned(),
+              "Prepared physical page identity invalid");
+      auto cost = part.at("gpu_payload_bytes").get<uint64_t>();
+      require(cost > 0 && cost <= 32 * 1048576, "Prepared upload page exceeds limit");
+      payload += cost;
+      const auto& files = part.at("files");
+      require(files.is_array() && files.size() == 3, "Prepared physical page files incomplete");
+      std::set<std::string> seen;
+      for (const auto& file : files) {
+        const auto filename = file.at("name").get<std::string>();
+        require((filename == "geometry.gltf" || filename == "geometry.bin" || filename == "atlas.jpg") &&
+                    seen.insert(filename).second,
+                "Prepared physical page filename invalid");
+        auto bytes = read(owned(root, folder.lexically_relative(root) / expected / filename), 32 * 1048576);
+        require(file.at("bytes") == bytes.size() && file.at("sha256") == digest(bytes),
+                "Prepared physical page checksum differs");
+        if (filename == "geometry.gltf")
+          checkUris(Json::parse(bytes));
+      }
+    }
+    require(marker.at("gpu_payload_bytes") == payload && payload <= uint64_t(family ? 256 : 384) * 1048576,
+            "Prepared complete bundle exceeds limit");
+  }
+} // namespace hongtu::landscape::prepared
diff --git a/Application/native/landscape_prepared_mounts.hpp b/Application/native/landscape_prepared_mounts.hpp
new file mode 100644
index 0000000..7b4e58b
--- /dev/null
+++ b/Application/native/landscape_prepared_mounts.hpp
@@ -0,0 +1,96 @@
+#pragma once
+#include "landscape_prepared_cache.hpp"
+
+namespace hongtu::landscape::prepared {
+  struct BundleOwners {
+    fs::path dataRoot, producerRoot, cacheRoot;
+    bool historicalOriginalPixels = false;
+    std::string markerSHA256;
+    bool mounted = false;
+  };
+
+  inline BundleOwners bundleOwners(
+      const fs::path& primary, const fs::path& registry, int tile, int depth, const std::string& parent) {
+    const auto name = bundleName(tile, depth, parent);
+    BundleOwners result{primary, primary, primary / "work/zhumadian_native_chunk_cache", false, {}, false};
+    if (registry.empty())
+      return result;
+    require(registry.is_absolute(), "Prepared mount registry must be absolute");
+    const auto document = Json::parse(read(registry, 1048576));
+    require(document.at("schema") == "hongtu.landscape.prepared_mounts.v1" &&
+                fs::u8path(document.at("primaryRoot").get<std::string>()).lexically_normal() == primary,
+            "Prepared mount registry primary owner differs");
+    const auto& rows = document.at("bundles");
+    require(rows.is_array() && rows.size() <= 256, "Prepared mount registry exceeds limit");
+    std::set<std::string> names;
+    for (const auto& row : rows) {
+      const auto rowName =
+          bundleName(row.at("tile").get<int>(), row.at("depth").get<int>(), row.at("parent").get<std::string>());
+      require(row.at("name") == rowName && names.insert(rowName).second,
+              "Prepared mount identity duplicated or invalid");
+      if (rowName != name)
+        continue;
+      auto dataRoot = fs::u8path(row.at("dataRoot").get<std::string>()).lexically_normal();
+      auto producerRoot = fs::u8path(row.at("producerRoot").get<std::string>()).lexically_normal();
+      require(dataRoot.is_absolute() && producerRoot.is_absolute(), "Prepared mount owners must be absolute");
+      owned(dataRoot, ".");
+      owned(producerRoot, ".");
+      const auto markerSHA = row.at("markerSHA256").get<std::string>();
+      require(std::regex_match(markerSHA, std::regex("[0-9a-f]{64}")), "Prepared mount marker identity invalid");
+      const auto& producers = row.at("producerFiles");
+      require(producers.is_object() && !producers.empty() && producers.size() <= 11,
+              "Prepared mount producer set invalid");
+      for (const auto& [file, expected] : producers.items()) {
+        require(std::regex_match(file, std::regex("[a-z0-9_]+\\.py")) && expected.is_string() &&
+                    std::regex_match(expected.get<std::string>(), std::regex("[0-9a-f]{64}")),
+                "Prepared mount producer path or identity invalid");
+        require(digest(read(owned(producerRoot, fs::path("tools") / file), 4 * 1048576)) == expected.get<std::string>(),
+                "Prepared mount producer snapshot changed");
+      }
+      auto cacheRoot = row.contains("cacheRoot") ? fs::u8path(row.at("cacheRoot").get<std::string>()).lexically_normal()
+                                                 : dataRoot / "work/zhumadian_native_chunk_cache";
+      require(cacheRoot.is_absolute(), "Prepared mount cache owner must be absolute");
+      owned(dataRoot, cacheRoot.lexically_relative(dataRoot));
+      const auto recipe = row.value("recipe", std::string{});
+      require(recipe.empty() || recipe == "original_pixels_2e6d5045", "Prepared mount recipe is unsupported");
+      const bool historical = !recipe.empty();
+      if (historical) {
+        const auto exporter = fs::u8path(row.at("exporterFile").get<std::string>());
+        require(exporter.is_absolute(), "Historical exporter identity path must be absolute");
+        require(digest(read(owned(exporter.parent_path(), exporter.filename()), 16 * 1048576)) ==
+                    "e67ec3ffc4cd806e25a68e723311ae575007b856e33d96aa93d81d3fe3a2d1ba",
+                "Historical exporter bytes differ; it is never executed");
+      }
+      result = {dataRoot, producerRoot, cacheRoot, historical, markerSHA, true};
+    }
+    return result;
+  }
+
+  inline BundleOwners bundleOwnersFromEnvironment(const fs::path& primary,
+                                                  int tile,
+                                                  int depth,
+                                                  const std::string& parent) {
+#ifdef _WIN32
+    const DWORD length = GetEnvironmentVariableW(L"HT_LANDSCAPE_PREPARED_MOUNTS", nullptr, 0);
+    if (length) {
+      require(length < 32768, "Prepared mount registry path exceeds limit");
+      std::wstring value(length, L'\0');
+      const DWORD copied = GetEnvironmentVariableW(L"HT_LANDSCAPE_PREPARED_MOUNTS", value.data(), length);
+      require(copied > 0 && copied < length, "Prepared mount registry path changed");
+      value.resize(copied);
+      return bundleOwners(primary, fs::path(value), tile, depth, parent);
+    }
+#endif
+    return bundleOwners(primary, {}, tile, depth, parent);
+  }
+
+  // Caller holds both existing read-only locks. The marker and producer
+  // identities are checked before the unchanged payload and topology checks.
+  inline void validateMountedMarker(const BundleOwners& owners, const fs::path& folder) {
+    if (!owners.mounted)
+      return;
+    const auto relative = folder.lexically_relative(owners.dataRoot) / "complete.json";
+    require(digest(read(owned(owners.dataRoot, relative), 16 * 1048576)) == owners.markerSHA256,
+            "Prepared mount marker changed");
+  }
+} // namespace hongtu::landscape::prepared

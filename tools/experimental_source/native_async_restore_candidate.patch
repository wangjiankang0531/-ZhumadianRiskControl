-        span.first += prefixIndices;
-        ranges.push_back(span);
-      }
-    std::sort(ranges.begin(), ranges.end(), [](auto a, auto b) { return a.first < b.first; });
-    cmd->bindDescriptorSet(0, baseDescriptor, layout);
-    cmd->bindVertexBuffer(0, vbo);
-    cmd->bindIndexBuffer(ibo);
-    drawnBase = drawnChild = 0;
-    for (const auto& span : hongtu::asset::retainedMeshIndexRanges(indexCount, ranges)) {
-      cmd->drawIndexed(span.count, 1, span.first);
-      drawnBase += span.count;
-    }
-    for (const auto& [id, ready] : resident) {
-      const auto drawBundle = [&](const Resident& bundle) {
-        for (size_t partIndex = 0; partIndex < bundle.parts.size(); ++partIndex) {
-          const auto& part = bundle.parts[partIndex];
-          std::vector<hongtu::asset::MeshIndexRange> hidden;
-          if (ready.sourceCut)
-            for (const auto& [name, node] : bundle.sources)
-              if (!ready.sourceCut->visible().contains(name))
-                for (const auto& span : node.spans)
-                  if (span.part == partIndex)
-                    hidden.push_back({span.first, span.count});
-          std::sort(hidden.begin(), hidden.end(), [](auto a, auto b) { return a.first < b.first; });
-          cmd->bindDescriptorSet(0, part.descriptor, layout);
-          cmd->bindVertexBuffer(0, part.vertices);
-          cmd->bindIndexBuffer(part.indices);
-          for (const auto& span : hongtu::asset::retainedMeshIndexRanges(part.indexCount, hidden)) {
-            cmd->drawIndexed(span.count, 1, span.first);
-            drawnChild += span.count;
-          }
-        }
-      };
-      if (ready.parts.empty()) {
-        cmd->bindDescriptorSet(0, ready.descriptor, layout);
-        cmd->bindVertexBuffer(0, ready.vertices);
-        cmd->bindIndexBuffer(ready.indices);
-        cmd->drawIndexed(ready.indexCount);
-        drawnChild += ready.indexCount;
-      } else {
-        drawBundle(ready);
-        for (const auto& [parent, family] : ready.families)
-          drawBundle(family);
-      }
-    }
-  }

+// Read only the explicitly pinned metadata index. Real decoding still validates bundles and locks.
+fs::path nativeFamilyIndexEnvironmentPath(const wchar_t* key) {
+ const DWORD size=GetEnvironmentVariableW(key,nullptr,0);if(!size || size>=32768)throw std::runtime_error("Missing bounded family index environment");
+ std::wstring value(size,L'\0');const DWORD actual=GetEnvironmentVariableW(key,value.data(),size);if(!actual || actual>=size)throw std::runtime_error("Family index environment changed");value.resize(actual);return fs::path(value);
+}
+nlohmann::json readNativeFamilyAdmissionIndex() {
+ namespace prepared=hongtu::landscape::prepared;
+ const auto primary=prepared::rootFromEnvironment();if(primary.empty())throw std::runtime_error("Family admission index requires prepared read-only mode");
+ const auto path=nativeFamilyIndexEnvironmentPath(L"HT_NATIVE_FAMILY_ADMISSION_INDEX");if(!path.is_absolute())throw std::runtime_error("Family index path must be absolute");
+ const char* expected=std::getenv("HT_NATIVE_FAMILY_ADMISSION_INDEX_SHA256");if(!expected || !std::regex_match(expected,std::regex("[0-9a-f]{64}")))throw std::runtime_error("Family index SHA missing");
+ const auto bytes=prepared::read(prepared::owned(path.parent_path(),path.filename()),4*1048576);if(prepared::digest(bytes)!=expected)throw std::runtime_error("Family admission index changed");
+ const auto index=nlohmann::json::parse(bytes);if(index.at("schema").get<std::string>()!="xnby.native-family-admission-index.v2" || index.at("primaryPackageSHA256").get<std::string>()!=prepared::digest(prepared::read(prepared::owned(primary,"package.json"),16*1048576)))throw std::runtime_error("Family admission package differs");

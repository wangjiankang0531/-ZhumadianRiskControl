+ const auto& rows=index.at("families");if(!rows.is_array() || rows.size()>256)throw std::runtime_error("Family admission row limit");
+ nlohmann::json verified=nlohmann::json::array();
+ for(const auto& row:rows) {
+  const int tile=row.at("tile").get<int>(),depth=row.at("depth").get<int>();const std::string parent=row.at("parent").get<std::string>();
+  const auto owners=prepared::bundleOwnersFromEnvironment(primary,tile,depth,parent);const auto name=prepared::bundleName(tile,depth,parent);const auto folder=owners.cacheRoot/name;
+  const auto markerBytes=prepared::read(prepared::owned(owners.dataRoot,(folder/"complete.json").lexically_relative(owners.dataRoot)),16*1048576);
+  if(prepared::digest(markerBytes)!=row.at("markerSHA256").get<std::string>())throw std::runtime_error("Family admission marker changed");
+  prepared::validateMountedMarker(owners,folder);const auto marker=nlohmann::json::parse(markerBytes);
+  if(marker.at("schema").get<std::string>()!="xnby.osgb_native_family.v1" || marker.at("tile_id").get<int>()!=tile || marker.at("replacement_parent").get<std::string>()!=parent || !marker.at("complete_sibling_family").get<bool>())throw std::runtime_error("Family admission marker identity invalid");
+  const bool locks=fs::exists(owners.cacheRoot/".locks"/("tile_"+std::to_string(tile)+".lock")) && fs::exists(owners.cacheRoot/".locks"/(name+".lock"));
+  if(row.at("payloadBytes").get<uint64_t>()!=marker.at("gpu_payload_bytes").get<uint64_t>() || row.at("edge").get<double>()!=marker.at("longest_edge_p90_m").get<double>() || row.at("texel").get<double>()!=marker.at("texel_world_p90_m").get<double>() || row.at("available").get<bool>()!=locks)throw std::runtime_error("Family admission hints differ from marker");

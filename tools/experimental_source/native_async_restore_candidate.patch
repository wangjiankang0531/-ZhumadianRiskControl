+      {"a1",{"a11","a12"}},{"a11",{}},{"a12",{}},{"a2",{}},{"b1",{}},{"b2",{}}};
+
+    hongtu::renderer::NativeSourceFrontier::Cut cut=mixed?decltype(cut){"a1","a2","b"}:decltype(cut){"a1","a2","b1","b2"};
+
+    r.sourceCut=std::make_shared<hongtu::renderer::NativeSourceFrontier>(nodes,"r",cut,80,100);

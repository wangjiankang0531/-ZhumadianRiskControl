diff --git a/Application/native/native_retained_page_identity.inl b/Application/native/native_retained_page_identity.inl
new file mode 100644
index 0000000..01e1d9d
--- /dev/null
+++ b/Application/native/native_retained_page_identity.inl
@@ -0,0 +1,55 @@
+// Retained page identity covers decoded geometry and actual texture pixels.
+// It is an in-process corruption guard, not a cryptographic authenticity claim.
+template <class Cpu> uint64_t nativePageIdentity(const Cpu &cpu) {
+  uint64_t value = 14695981039346656037ull;
+  const auto append = [&](const auto &item) {
+    const auto *bytes = reinterpret_cast<const unsigned char *>(&item);
+    for (size_t i = 0; i < sizeof(item); ++i) { value ^= bytes[i]; value *= 1099511628211ull; }
+  };
+  append(cpu.image.width); append(cpu.image.height); append(cpu.payload);
+  for (const auto &v : cpu.vertices) {
+    for (int axis = 0; axis < 3; ++axis) { append(v.position[axis]); append(v.normal[axis]); }
+    for (int axis = 0; axis < 2; ++axis) append(v.uv[axis]);
+  }
+  for (auto index : cpu.indices) append(index);
+  for (auto pixel : cpu.image.rgba) append(pixel);
+  if constexpr (requires { cpu.bc7Mips; }) {
+    append(cpu.bc7Mips.size());
+    for (const auto& level:cpu.bc7Mips) { append(level.size());for (auto byte:level) append(byte); }
+  }
+  return value;
+}
+struct NativePageRestorePlan { std::vector<size_t> parts; uint64_t bytes = 0; };
+template <class Owner, class Cpu>
+NativePageRestorePlan nativePageRestorePlan(const Owner &owner, const Cpu &cpu, const std::string &source) {
+  if (owner.parts.size() != cpu.parts.size() || owner.sources.size() != cpu.sources.size())
+    throw std::logic_error("Restored bundle layout changed");
+  for (const auto &[name, saved] : owner.sources) {
+    const auto it = cpu.sources.find(name);
+    if (it == cpu.sources.end() || saved.depth != it->second.depth || saved.triangles != it->second.triangles ||
+        saved.children != it->second.children || saved.spans.size() != it->second.spans.size())
+      throw std::logic_error("Restored source ownership changed");
+    for (size_t i = 0; i < saved.spans.size(); ++i) {
+      const auto &a = saved.spans[i]; const auto &b = it->second.spans[i];
+      if (a.part != b.part || a.first != b.first || a.count != b.count)
+        throw std::logic_error("Restored source span changed");
+    }
+  }
+  NativePageRestorePlan plan;
+  std::set<size_t> missing;
+  const auto &record = owner.sources.at(source);
+  if (record.spans.empty()) throw std::logic_error("Restored source has no spans");
+  for (const auto &span : record.spans) {
+    if (!span.count || span.part >= owner.parts.size()) throw std::logic_error("Restored span escapes bundle");
+    const auto &saved = owner.parts.at(span.part); const auto &fresh = cpu.parts.at(span.part);
+    if (!saved.originalPageBytes || saved.originalPageBytes != fresh.payload ||
+        saved.pageIdentity != nativePageIdentity(fresh) || saved.indexCount != fresh.indices.size())
+      throw std::logic_error("Restored page geometry or texture differs from original upload");
+    if (!saved.payload) missing.insert(span.part);
+    else if (saved.payload != saved.originalPageBytes || !saved.descriptor || !saved.view || !saved.texture ||
+             !saved.vertices || !saved.indices) throw std::logic_error("Partially live restore page");
+  }
+  for (size_t index : missing) { plan.parts.push_back(index); plan.bytes += cpu.parts.at(index).payload; }
+  if (plan.bytes > owner.retiredBasePayload) throw std::logic_error("Restored bytes exceed retired pages");
+  return plan;
+}
diff --git a/Application/native/native_retained_page_lifecycle.inl b/Application/native/native_retained_page_lifecycle.inl
new file mode 100644
index 0000000..c1d9555
--- /dev/null
+++ b/Application/native/native_retained_page_lifecycle.inl
@@ -0,0 +1,105 @@
+struct RetainedPageResourceSnapshot {bool descriptorStatsAvailable=false;uint64_t liveDescriptors=0,allocationBytes=0,allocationCount=0;};
+struct RetainedPageResourceEvent {uint64_t modelBytes=0,pages=0;RetainedPageResourceSnapshot before,after;};
+std::vector<RetainedPageResourceEvent> retainedPageResourceEvents;
+uint64_t retainedPageResourceEventsDropped=0;
+bool retainedPageLifecycleEnabled() const {
+ const char* flag=std::getenv("HT_NATIVE_RETAINED_PAGE_LIFECYCLE");
+ return visibilityScheduling() && visibleRootGuardEnabled() && flag && std::string(flag)=="1";
+}
+// Source metadata survives GPU-page retirement; a rollback needs every page.
+static const Resident *sourcePageOwner(const Resident &ready, const std::string &name) {
+  if (ready.sources.contains(name)) return &ready;
+  for (const auto &[parent, family] : ready.families)
+    if (family.sources.contains(name)) return &family;
+  return nullptr;
+}
+static bool sourcePagesAvailable(const Resident &ready, const std::string &name) {
+  const auto *owner = sourcePageOwner(ready, name);
+  if (!owner) return false;
+  const auto &source = owner->sources.at(name);
+  if (source.spans.empty()) return false;
+  for (const auto &span : source.spans) {
+    if (!span.count || span.part >= owner->parts.size()) return false;
+    const auto &part = owner->parts[span.part];
+    if (!part.payload || !part.descriptor || !part.view || !part.texture || !part.vertices || !part.indices)
+      return false;
+  }
+  return true;
+}
+// Use full-cut membership, never one visibility histogram or an occluded frame.
+static std::vector<size_t> hiddenPageIndices(const Resident &bundle,
+                                            const hongtu::renderer::NativeSourceFrontier::Cut &cut) {
+  if (bundle.parts.empty()) return {};
+  std::vector<bool> referenced(bundle.parts.size()), visible(bundle.parts.size());
+  for (const auto &[name, source] : bundle.sources)
+    for (const auto &span : source.spans) {
+      if (!span.count || span.part >= bundle.parts.size())
+        throw std::logic_error("Invalid source page span");
+      referenced[span.part] = true;
+      visible[span.part] = visible[span.part] || cut.contains(name);
+    }
+  std::vector<size_t> result;
+  for (size_t i = 0; i < bundle.parts.size(); ++i)
+    if (bundle.parts[i].payload && referenced[i] && !visible[i]) result.push_back(i);
+  return result;
+}
+uint64_t hiddenBasePageRetirements = 0, hiddenBaseBytesRetired = 0, missingBasePageFallbacks = 0;
+uint64_t hiddenSourcePageRetirements = 0, hiddenSourceBytesRetired = 0;
+uint64_t pageRetirementEpoch = uint64_t(-1);
+uint64_t hiddenBasePagesBytes(const Resident &ready) const {
+  if (!ready.sourceCut) return 0;
+  uint64_t bytes = 0;
+  for (size_t i : hiddenPageIndices(ready, ready.sourceCut->visible())) bytes += ready.parts[i].payload;
+  return bytes;
+}
+void retireHiddenBasePages() {
+  if (!retainedPageLifecycleEnabled() || pageRetirementEpoch == familyCommits) return;
+  bool deferred = false;
+  for (auto &[id, ready] : resident) {
+    if (!ready.sourceCut) continue;
+    if ((familyTicket && familyRequest.id == id) || (familyPending.valid() && familyRequest.id == id) ||
+        (familyStaged && familyRequest.id == id) ||
+        (staged && stagingId == id) || (pending.valid() && pendingId == id)) {
+      deferred = true;
+      continue;
+    }
+    struct Plan { Resident *bundle; std::vector<size_t> pages; uint64_t bytes; };
+    std::vector<Plan> plans;
+    uint64_t total = 0;
+    const auto &cut = ready.sourceCut->visible();
+    const auto plan = [&](Resident &bundle) {
+      auto pages = hiddenPageIndices(bundle, cut);
+      uint64_t bytes = 0;
+      for (size_t i : pages) bytes += bundle.parts[i].payload;
+      if (bytes > bundle.payload) throw std::logic_error("Invalid source bundle page accounting");
+      if (bytes) { total += bytes; plans.push_back({&bundle, std::move(pages), bytes}); }
+    };
+    plan(ready);
+    for (auto &[parent, family] : ready.families) plan(family);
+    if (!total) continue;
+    if (total > ready.payload || total > payload || ready.sourceCut->residentBytes() != ready.payload)
+      throw std::logic_error("Invalid hidden source page accounting");
+    const auto savedCut = cut;
+    const auto resourceBefore=captureRetainedPageResources();
+    uint64_t retiredPages=0;for(const auto& action:plans)retiredPages+=action.pages.size();
+    // All spans and byte totals were checked before releasing any live resource.
+    for (auto &action : plans) {
+      for (size_t i : action.pages) {
+        auto &part = action.bundle->parts[i];
+        part.descriptor.reset(); part.view.reset(); part.texture.reset();
+        part.vertices.reset(); part.indices.reset(); part.payload = 0;
+      }
+      action.bundle->retiredBasePayload += action.bytes;
+      if (action.bundle != &ready) action.bundle->payload -= action.bytes;
+      else { ++hiddenBasePageRetirements; hiddenBaseBytesRetired += action.bytes; }
+      hiddenSourcePageRetirements += action.pages.size();
+      hiddenSourceBytesRetired += action.bytes;
+    }
+    ready.payload -= total; payload -= total;
+    ready.sourceCut->reset(savedCut, ready.payload);
+    const auto resourceAfter=captureRetainedPageResources();
+    if(retainedPageResourceEvents.size()<64)retainedPageResourceEvents.push_back({total,retiredPages,resourceBefore,resourceAfter});else ++retainedPageResourceEventsDropped;
+  }
+  // Only family commits can newly hide retained pages. Retry skipped active roots.
+  if (!deferred) pageRetirementEpoch = familyCommits;
+}
diff --git a/Application/native/native_retained_parent_restore.inl b/Application/native/native_retained_parent_restore.inl
new file mode 100644
index 0000000..0ba64e7
--- /dev/null
+++ b/Application/native/native_retained_parent_restore.inl
@@ -0,0 +1,170 @@
+bool retainedRestoreDiagnosticStarted=false,retainedRestoreDiagnosticDone=false,retainedRestoreDiagnosticFailed=false;
+int retainedRestoreDiagnosticId=-1;std::string retainedRestoreDiagnosticParent;
+bool retainedRestoreDiagnosticEnabled() const {const char* flag=std::getenv("HT_NATIVE_RETAINED_PARENT_DIAGNOSTIC");return retainedPageLifecycleEnabled() && flag && std::string(flag)=="1";}
+std::string familyRestoreSource, familyRestoreOwner;
+std::vector<size_t> familyRestoreParts;
+std::set<std::pair<int, std::string>> parentRestoreFailed;
+std::map<std::pair<int, std::string>, uint64_t> parentRestoreCosts;
+uint64_t parentPageRestorations = 0, parentRestoreCancellations = 0;
+Resident *restoreOwner(Resident &ready) {
+  return familyRestoreOwner.empty() ? &ready :
+      ready.families.contains(familyRestoreOwner) ? &ready.families.at(familyRestoreOwner) : nullptr;
+}
+
+
+
+bool serviceRetainedParentPages(RHIDevice* device,const ShowcaseMaterialTextureBinding& material,glm::vec3 camera,float fov,int height) {
+  std::vector<std::pair<int, std::string>> restoreCandidates;
+  for (auto& [id, ready] : resident) {
+    if (!ready.sourceCut) continue;
+    if (!visibilityScheduling() && id != focusId && ready.payload > rootBudget(id)) {
+      if (std::all_of(ready.sources.begin(), ready.sources.end(),
+          [&](const auto &entry) { return sourcePagesAvailable(ready, entry.first); })) resetFamilies(ready);
+      continue;
+    }
+    std::vector<std::string> rollback;
+    for (const auto& [parent, family] : ready.families) {
+      const auto* node = sourceRecord(ready, parent);
+      if (!node || !node->hasBounds) continue;
+      const float distance = glm::length(glm::max(glm::max(node->low-camera, camera-node->high), glm::vec3(0)));
+      if (hongtu::renderer::projectedNativeEdge(std::max(node->edge,node->texel*4),distance,fov,height)<2)
+        rollback.push_back(parent);
+    }
+    for (const auto &parent : rollback) {
+      if (!ready.families.contains(parent)) continue;
+      if (!sourcePagesAvailable(ready,parent)) {
+        // Keep the complete child cut when its parent cannot be restored.
+        // Ordinary visibility/budget eviction remains responsible for root removal.
+        if (!parentRestoreFailed.contains({id,parent})) restoreCandidates.emplace_back(id,parent);
+      } else if (!(familyStaged && familyRequest.id==id) && !(familyPending.valid() && familyRequest.id==id))

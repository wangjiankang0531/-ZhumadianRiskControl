+#include "../native/native_retained_page_lifecycle.inl"
+  RetainedPageResourceSnapshot captureRetainedPageResources()const{return {};}
+
+  explicit PageFixture(bool mixed=false) {
+
+    auto &r=resident[0];r.sources={{"a",{{{0,9}}}},{"b",{{{0,9}}}}};
+
+    using Node=hongtu::renderer::NativeSourceNode;
+
+    std::vector<Node> nodes={{"r",{"a","b"}},{"a",{"a1","a2"}},{"b",{"b1","b2"}},

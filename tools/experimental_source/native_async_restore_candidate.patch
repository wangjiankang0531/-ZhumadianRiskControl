+++ b/Application/native/native_visible_initial_coverage.inl
@@ -0,0 +1,21 @@
+// Initial visible root coverage precedes optional deeper sibling families.
+// The byte budget is unchanged. A bounded root count follows the actual readback.
+bool visibleInitialCoverageEnabled() const {
+  const char* configured=std::getenv("HT_NATIVE_VISIBLE_INITIAL_COVERAGE");
+  return visibleRootGuardEnabled() && configured && std::string(configured)=="1";
+}
+size_t visibleCoverageResidentLimit(size_t legacyLimit) const {
+  if (!visibleInitialCoverageEnabled()) return legacyLimit;
+  std::set<int> visible;
+  for (const auto& [key,bins] : visibilityBins)
+    if (retainVisibleSourceRoot(key.root)) visible.insert(key.root);
+  // Camera changes must not invalidate a still-owned resident set before retirement.
+  return std::clamp<size_t>(std::max(resident.size(),visible.size()),legacyLimit,64);
+}
+bool visibleInitialCoveragePending(float fov,int height) const {
+  if (!visibleInitialCoverageEnabled()) return false;
+  for (const auto& [id,depth] : desired)
+    if (!resident.contains(id) && retainVisibleSourceRoot(id) &&
+        visibilityRootEligible(id,depth,fov,height)) return true;
+  return false; // Failed or presently inadmissible roots cannot block refinement forever.
+}
diff --git a/Application/native/native_visible_root_guard.inl b/Application/native/native_visible_root_guard.inl
new file mode 100644
index 0000000..d74a9ad
--- /dev/null
+++ b/Application/native/native_visible_root_guard.inl
@@ -0,0 +1,28 @@
+// Included inside the pager or an independent planner fixture.
+// Opt-in retention uses the depth-tested readback, not geographic proximity.
+bool visibleRootGuardEnabled() const {
+  const char *value = std::getenv("HT_NATIVE_VISIBLE_ROOT_GUARD");
+  return visibilityScheduling() && value && std::string(value) == "1";
+}
+bool retainVisibleSourceRoot(int id) const {
+  if (!visibleRootGuardEnabled())
+    return false;
+  for (auto it = visibilityBins.lower_bound({id, ""});
+       it != visibilityBins.end() && it->first.root == id; ++it) {
+    for (double weight : it->second) {
+      // Invalid coverage cannot justify discarding an already resident root.
+      if (!std::isfinite(weight) || weight != 0.0)
+        return true;
+    }
+  }
+  return false;
+}
+bool guardParentPagesAvailable(const Resident &ready, const std::string &parent) const {
+  if(retainedPageLifecycleEnabled())return sourcePagesAvailable(ready,parent);
+  if (ready.sources.contains(parent))
+    return true;
+  for (const auto &[name, bundle] : ready.families)
+    if (name != parent && bundle.sources.contains(parent))
+      return true;
+  return false;
+}
